{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "regions": ["hnd1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,assets/fonts/**}"
    },
    "api/hourly.ts": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,assets/fonts/**}",
      "experimentalTriggers": [{ "type": "schedule/v1beta" }]
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" }
  ],
  "schedules": {
    "douyin-hourly": {
      "schedule": "0 * * * *",
      "timezone": "UTC",
      "jitter": 15,
      "function": "api/hourly"
    }
  }
}
