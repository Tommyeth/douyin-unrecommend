# 用两次 openssl rand -hex 32 分别生成，替换下面的占位符。
ADMIN_TOKEN=replace-with-a-unique-random-admin-token
AUTH_SECRET=replace-with-a-different-random-encryption-key
MODE=notify
POLL_INTERVAL_SECONDS=300
MAX_PAGES=10
MAX_ACTIONS=5
ACTION_DELAY_MS=3000
PAGE_TIMEOUT_MS=20000
IGNORE_IDS=
# 四种渠道可任意组合。使用 examples/notifications.json 的结构，压缩为一行后放到此变量。
NOTIFICATIONS_JSON=[]
# Node 服务器选项（Cloudflare 无需设置）：
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/state.sqlite
