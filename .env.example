# 用两次 openssl rand -hex 32 分别生成，替换下面的占位符。
ADMIN_TOKEN=replace-with-a-unique-random-admin-token
AUTH_SECRET=replace-with-a-different-random-encryption-key
MODE=notify
# 默认每小时检查一次。Docker 可设 300（5 分钟）；以 60 秒递增。
# Vercel 默认调度为 900 秒（15 分钟），检查间隔为 900 的倍数。
POLL_INTERVAL_SECONDS=3600
MAX_PAGES=10
MAX_ACTIONS=5
ACTION_DELAY_MS=3000
PAGE_TIMEOUT_MS=20000
IGNORE_IDS=
# 四种渠道可任意组合。使用 examples/notifications.json 的结构，压缩为一行后放到此变量。
NOTIFICATIONS_JSON=[]
# VPS / Node 服务器选项（Vercel / Cloudflare 无需设置）：
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/browser.sqlite
# Docker Compose 自动启用桌面；本地 npm start 不启用。
DESKTOP_ENABLED=0
# HTTPS 反向代理时填写完整来源，例如 https://douyin.example.com（无路径）。
# 使用 SSH 隧道访问 localhost 时留空。
PUBLIC_ORIGIN=
