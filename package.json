{
  "name": "douyin-unrecommend",
  "version": "0.2.0",
  "private": true,
  "description": "抖音推荐防误触：扫码登录、定时检测、批量取消、多渠道提醒，支持纯 Cloudflare 与自托管服务器",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prebuild:worker": "node scripts/prepare-wasm.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "predeploy": "node scripts/prepare-wasm.mjs",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply douyin-unrecommend --remote",
    "test:worker": "npm run build:worker && node scripts/worker-smoke.cjs",
    "precheck": "node scripts/prepare-wasm.mjs",
    "pretest": "node scripts/prepare-wasm.mjs",
    "predev": "node scripts/prepare-wasm.mjs",
    "prestart": "node scripts/prepare-wasm.mjs"
  },
  "dependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/cousine": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "@hono/node-server": "2.1.8",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "canvaskit-wasm": "0.42.0",
    "hono": "4.13.18",
    "linkedom": "0.18.15",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261113.0-beta",
    "prettier": "3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.162.0"
  }
}
