{
  "name": "douyin-unrecommend",
  "version": "0.3.0",
  "private": true,
  "description": "抖音推荐管理：Vercel / VPS Docker / Cloudflare Paid 混合版、扫码登录、定时取消与多渠道提醒",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "predev": "npm run build:desktop",
    "prestart": "npm run build:desktop",
    "build:vercel": "node scripts/build-vercel.mjs",
    "dev:vercel": "tsx --env-file=.env.local src/vercel/local.ts",
    "test:browser": "tsx --test tests/browser.test.ts",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:dots": "python3 scripts/package-dots.py",
    "build:hybrid": "wrangler deploy --config wrangler.hybrid.jsonc --dry-run --outdir dist/hybrid",
    "deploy:hybrid": "wrangler deploy --config wrangler.hybrid.jsonc",
    "schedule:vercel": "node scripts/configure-vercel-schedule.mjs",
    "test:hybrid": "npm run build:hybrid && node --import tsx scripts/hybrid-smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.4.0",
    "@hono/node-server": "2.1.8",
    "@novnc/novnc": "1.7.0",
    "@sparticuz/chromium": "153.0.0",
    "@vercel/blob": "2.9.0",
    "@vercel/schedules": "0.0.3",
    "hono": "4.13.18",
    "playwright-core": "1.65.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261113.0-beta",
    "prettier": "3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.162.0"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
